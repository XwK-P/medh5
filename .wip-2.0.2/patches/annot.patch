+    let table = if kind == "layers" { "layer_class_ids" } else { "bit_class_ids" };
+    let shape_of = |name: &str| payload.datasets.get(name).map(PayloadData::shape);
+    let rows: Option<Vec<Vec<i64>>> = match payload.datasets.get(table) {
+        None => None,
+        Some(_) => {
